; Engine configuration file.
; Sweatpunk technical spike. Godot 4.7.2.

config_version=5

[application]

config/name="Sweatpunk"
config/version="0.1.0"
run/main_scene="res://game/debug/debug_screen.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Auth="*res://services/auth_service.gd"
Reading="*res://services/reading_timer_service.gd"
Health="*res://services/health_service.gd"
Ads="*res://services/ads_service.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg", "res://addons/health_connect/plugin.cfg", "res://addons/healthkit/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[admob]

general/android/enabled=true
general/android/app_id="ca-app-pub-3940256099942544~3347511713"
general/android/enable_r8_optimization=false
general/android/disable_initialization_optimization=false
general/android/disable_ad_loading_optimization=false
general/ios/enabled=true
general/ios/app_id="ca-app-pub-3940256099942544~1458002511"
mediation/applovin=false
mediation/bidmachine=false
mediation/chartboost=false
mediation/dtexchange=false
mediation/imobile=false
mediation/inmobi=false
mediation/ironsource=false
mediation/line=false
mediation/maio=false
mediation/meta=false
mediation/mintegral=false
mediation/moloco=false
mediation/mytarget=false
mediation/pangle=false
mediation/pubmatic=false
mediation/unity_ads=false
mediation/vungle=false
