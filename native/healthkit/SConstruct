#!/usr/bin/env python
"""Build the HealthKit GDExtension against godot-cpp (api_version 4.7)."""

env = SConscript("godot-cpp/SConstruct", {"api_version": "4.7"})
env.Append(CPPPATH=["src/"])

sources = ["src/register_types.cpp", "src/healthkit_plugin.cpp"]
if env["platform"] == "ios":
    # SCons has no default builder for .mm. Force Objective-C++ explicitly.
    apple = env.Command(
        "src/healthkit_apple.o",
        "src/healthkit_apple.mm",
        "$CXX -o $TARGET -c -x objective-c++ -fobjc-arc -fmodules $CXXFLAGS $CCFLAGS $_CCCOMCOM $SOURCE",
    )
    sources.append(apple)

target_name = "bin/libhealthkit.{}.{}".format(env["platform"], env["target"])
if env["platform"] == "ios":
    library = env.StaticLibrary(target_name, source=sources)
else:
    library = env.SharedLibrary(target_name + env["SHLIBSUFFIX"], source=sources)

Default(library)
